# Copiar a /etc/seguimiento.env (dueño root, chmod 600: lo lee systemd). Nunca se sube al repositorio.
# Los valores con comillas dobles adentro (SUPERADMINS) van entre comillas simples.
DATABASE_URL='postgresql://seguimiento:CAMBIAR@localhost:5432/seguimiento'
SUPERADMINS='[{"name":"Nombre Apellido","email":"correo@empresa.com","password":"CAMBIAR"}]'
CUENTAS_PRUEBA=no
# Solo NGINX llega a la app
HOST=127.0.0.1
PORT=3000
# Respaldo diario (deploy/respaldo.sh)
BACKUP_PASSWORD='CAMBIAR'
RESPALDOS_DIR=/mnt/respaldos
RESPALDOS_DIAS=30
