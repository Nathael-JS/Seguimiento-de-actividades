# Entorno local: copia este archivo como .env (cp .env.ejemplo .env) y cambia los valores.
# .env NUNCA se sube al repositorio (está en .gitignore). Guía completa: ENTORNO_LOCAL.md

# Base de datos. Si la contraseña lleva @ # / : % ? & escríbelos codificados (@ = %40, # = %23, / = %2F ...)
DATABASE_URL='postgresql://seguimiento:CAMBIAR@localhost:5432/seguimiento'

# Super administradores: JSON en UN solo renglón, entre comillas simples. Entran solo por el acceso oculto del login
# (tres toques seguidos al número de versión del pie). Se pueden poner varios: [{...},{...}]
SUPERADMINS='[{"name":"Nombre Apellido","email":"correo@empresa.com","password":"CAMBIAR-Clave#2026"}]'

# Cuentas de prueba (80001-80004, contraseña demo1234): cualquier valor menos "no" las permite
CUENTAS_PRUEBA=si

# 127.0.0.1: solo esta máquina (o detrás de NGINX). 0.0.0.0: visible en la red, para probar desde otro equipo
HOST=127.0.0.1
PORT=3000
